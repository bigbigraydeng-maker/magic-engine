(version 1)
(deny default)

;; ── network: completely denied ──
(deny network*)

;; ── keychain / security services: denied ──
(deny mach-lookup (global-name "com.apple.SecurityServer"))
(deny mach-lookup (global-name "com.apple.securityd.xpc"))
(deny mach-lookup (global-name "com.apple.security.agent"))

;; ── deny /usr/bin/security to prevent keychain CLI access ──
(deny process-exec (literal "/usr/bin/security"))

;; ── process: allow fork/exec for node/vitest workers ──
(allow process-fork)
(allow process-exec)

;; ── signals ──
(allow signal)

;; ── sysctl read (node needs this) ──
(allow sysctl-read)

;; ── IPC: allow mach-lookup for system services node/vitest need ──
(allow mach-lookup (global-name "com.apple.system.logger"))
(allow mach-lookup (global-name "com.apple.system.notification_center"))
(allow mach-lookup (global-name "com.apple.CoreServices.coreservicesd"))
(allow mach-lookup (global-name "com.apple.lsd.mapdb"))
(allow mach-lookup (global-name "com.apple.coreservices.launchservicesd"))

;; ── read: root listing required for anything to start ──
(allow file-read* (literal "/"))

;; ── read: allow system paths ──
(allow file-read*
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/opt/homebrew")
  (subpath "/Library")
  (subpath "/System")
  (subpath "/dev")
  (subpath "/private/etc")
  (subpath "/private/var")
  (subpath "/var")
  (subpath "/etc"))

;; ── read: only allow the task's own tmp directory, not all of /private/tmp ──
(allow file-read* (subpath (param "TASK_TMP")))

;; deny reading the entire user home directory (secrets, configs, keys)
(deny file-read* (subpath (param "USER_HOME")))

;; but allow reading the work repo (under TASK_TMP)
(allow file-read* (subpath (param "WORK_REPO")))

;; ── write: default deny, then allow, then deny-override (last match wins) ──
(deny file-write*)

;; allow writing to the work repo
(allow file-write*
  (subpath (param "WORK_REPO")))

;; allow writing to the dedicated tmp home
(allow file-write*
  (subpath (param "SANDBOX_HOME")))

;; allow /dev/null and /dev/tty
(allow file-write*
  (literal "/dev/null")
  (literal "/dev/tty"))

;; deny-override: .git directory and sensitive files AFTER the allow (last match wins)
(deny file-write* (subpath (param "GIT_DIR")))
(deny file-write* (literal (param "WORK_AIDERCONF")))
(deny file-write* (literal (param "WORK_DOTENV")))
