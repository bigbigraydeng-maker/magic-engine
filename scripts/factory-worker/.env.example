# P21.J M2 本地 worker 配置(复制为 .env,填真值;.env 已 gitignore)
# 这些 key 只留在你 Mac 本地,绝不进 Render / 仓库。

# 必填:worker 领单工牌(= Render 上同名 env 的同一个值)
FACTORY_WORKER_TOKEN=

# 可选:生产端点(默认 https://app.magicengine.com.au)
# FACTORY_API_BASE=https://app.magicengine.com.au

# 可选:worker 标识(默认 mac-<hostname>);多机时区分
# FACTORY_WORKER_ID=mac-studio-01

# 可选:只领取该客户工单。服务端会再次验证它属于 FACTORY_WORKER_CLIENT_IDS 白名单；不填沿用现有全白名单行为。
FACTORY_WORKER_TARGET_CLIENT_ID=

# 生成路径需要(库存-only 装配可不填):muapi 视频生成 key,从 muapi.ai 后台取
MUAPI_API_KEY=
# MUAPI_KLING_SLUG=kling-v2.1-standard-i2v          # 待实测确认确切 slug
# MUAPI_SOURCE_IMAGE_URL=                            # I2V 源图(默认 bucket seed 帧)

# 可选:文案生成(不填走模板 fallback,溯源 angle 不编数字)
OPENAI_API_KEY=

# 可选:装配引擎路径(默认 ~/Documents/CTS_BrandKit/make_promo.py)
# MAKE_PROMO_PATH=/Users/you/Documents/CTS_BrandKit/make_promo.py
# BRAND_KIT_PATH=/Users/you/Documents/CTS_BrandKit

# 可选:轮询间隔(--loop 模式,默认 30000ms)
# FACTORY_POLL_INTERVAL_MS=30000

# bucket 公开读根(生成路径 source image 默认前缀用)
NEXT_PUBLIC_SUPABASE_URL=

# B3: 权威引擎 + brandkit 按客户走
# STUDIO_ROOT=~/Dropbox/MagicLab_Studio          # 默认;引擎=engine/make_promo.py,brandkit=<folder>/brandkit
# FACTORY_CLIENT_STUDIO={"<client_uuid>":"CTS","<client_uuid>":"Oztop"}   # client_id→studio 文件夹名

# R2a Remotion engine: clients (comma-separated client_id) allowed to use brief.engine='remotion'.
# Empty = every remotion order is refused. Assets live in <STUDIO_ROOT>/<folder>/remotion-assets/ (per client).
# FACTORY_REMOTION_CLIENT_IDS=

# Inngest Cloud dry-run pilot. Real values belong in .env only.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=0
# Client scope is configuration, never a shared-runtime default.
INNGEST_PILOT_CLIENT_ID=
INNGEST_PILOT_VERSION=cts-dry-run-v1
# Optional only for an explicitly approved crash/restart acceptance run.
# INNGEST_PILOT_CRASH_AFTER_EFFECT=1

# Inngest CTS production relay. The first release is one exact client, one exact
# recipe, one candidate, one local worker, then wait for Ray; it never publishes.
CTS_INNGEST_CLIENT_ID=
CTS_INNGEST_RECIPE_ID=single_image_i2v_multicut_9s
CTS_INNGEST_MAX_PROVIDER_USD=1
# Optional:reuse an existing local secrets file without copying it into this worktree.
# CTS_INNGEST_ENV_FILE=/absolute/path/to/factory-worker/.env
