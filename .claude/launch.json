{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "magic-engine",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "membership-deck",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["public/decks/magic-lab-class-membership/serve.py"],
      "port": 8799
    },
    {
      "name": "parkhomes-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "docs/clients/parkhomes/web"],
      "port": 4321
    },
    {
      "name": "marketing-website",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8877", "--directory", "website"],
      "port": 8877
    },
    {
      "name": "scratch-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8901", "--directory", ".claude/scratch", "--bind", "127.0.0.1"],
      "port": 8901
    }
  ]
}
