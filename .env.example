# Magic Engine — 环境变量模板
#
# 复制成 .env.local 后填值。**永远不要提交 .env.local。**
# 每个变量的用途、配在哪个平台、当前登记状态，见 docs/ENV.md
# 填完跑 `bash scripts/doctor.sh --env` 自检（掩码输出，不打印值）
#
# 标记说明：
#   [必需]   缺了跑不起来
#   [可选]   缺了对应功能不可用，但应用能起
#   [开关]   控制危险行为，注意确认状态

# ═══════════════════════════════════════════════════════════
# 1. 核心基础设施
# ═══════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=              # [必需] https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # [必需]
SUPABASE_SERVICE_ROLE_KEY=             # [必需] ME 全部数据访问走它（不用 end-user RLS）
CRON_SECRET=                           # [必需] 所有 /api/cron/* 的 Bearer 鉴权；GitHub Secrets 也要同一份

APP_URL=http://localhost:3001          # [可选] 应用自身域名，邮件/OAuth 回调拼接用
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_REPORT_BASE_URL=           # [可选] 报告分享链接基址
NEXT_PUBLIC_PROJECT_ID=                # [可选] Supabase project ref（前端用）

# 前端埋点
NEXT_PUBLIC_GA_MEASUREMENT_ID=         # [可选] Google Analytics
NEXT_PUBLIC_META_PIXEL_ID=             # [可选] Meta Pixel

# ═══════════════════════════════════════════════════════════
# 2. AI 模型
# ═══════════════════════════════════════════════════════════
OPENAI_API_KEY=                        # [必需] GPT-4o-mini 文案 / Vision / Realtime
ANTHROPIC_API_KEY=                     # [必需] Claude Sonnet — Brief / 策略 / 诸葛亮
PERPLEXITY_API_KEY=                    # [可选] AI 可见度追踪引擎之一
GEMINI_API_KEY=                        # [可选] AI 可见度追踪第 4 引擎
AI_TRACKER_ENABLE_CLAUDE=              # [开关] AI Tracker 是否跑 Claude 引擎

# Cloudflare AI Gateway — OpenAI/Anthropic 都走它代理。生产值在 render.yaml 内联。
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
# 仅当 Gateway 开了 Authenticated 模式才需要（否则会被拒），CF → AI Gateway → Settings 生成
CF_AIG_TOKEN=

# ═══════════════════════════════════════════════════════════
# 3. 视觉 / 视频 / 素材
# ═══════════════════════════════════════════════════════════
# ⚠️ 名字别写错：代码读的是 ATLAS_CLOUD_API_KEY，不是 ATLAS_API_KEY。见 docs/PITFALLS.md A1
ATLAS_CLOUD_API_KEY=                   # [必需] WaveSpeed 图片 + Seedance 视频（共用一把）
MODELSLAB_API_KEY=                     # [可选] Muapi 图/视频引擎（P21.J 后主用）
HEYGEN_API_KEY=                        # [可选] 数字人头像视频
HEYGEN_DEFAULT_AVATAR_ID=
HEYGEN_DEFAULT_VOICE_ID=
UNSPLASH_ACCESS_KEY=                   # [可选] 免费商用图库，素材抓取首选源
SUPADATA_API_KEY=                      # [可选] 视频字幕 / 转录
# ⚠️ 代码里两个名字都在读，建议两个都填。见 docs/PITFALLS.md A3
APIFY_API_KEY=
APIFY_TOKEN=

# ═══════════════════════════════════════════════════════════
# 4. SEO / 数据源
# ═══════════════════════════════════════════════════════════
DATAFORSEO_LOGIN=                      # [必需] 主数据源：关键词量/KD/SERP/外链
DATAFORSEO_PASSWORD=                   # [必需]
SEMRUSH_DB=au                          # [可选] 市场库 au/nz —— 这个还在用，别跟 SEMRUSH_API_KEY 混为一谈
SERPAPI_API_KEY=                       # [可选] SERP 抓取 / Google AI Overviews
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=    # [可选] GA4 / GSC 服务账号 JSON（整段 JSON 字符串）
GOOGLE_CLIENT_ID=                      # [可选] Google OAuth（客户授权 GSC/GA4/GBP）
GOOGLE_CLIENT_SECRET=
GOOGLE_GBP_ACCESS_TOKEN=               # [可选] Google Business Profile
GOOGLE_PLACES_API_KEY=                 # [可选] 本地商户 / 口碑数据
YOUTUBE_API_KEY=                       # [可选]
ABR_GUID=                              # [可选] 澳洲 ABN 企业注册库
NZBN_API_KEY=                          # [可选] 新西兰 NZBN 企业注册库

# ═══════════════════════════════════════════════════════════
# 5. 广告平台
# ═══════════════════════════════════════════════════════════
META_SYSTEM_USER_TOKEN=                # [可选] 缺了执行看板「直接执行」返回 424
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=            # [可选] 等审核，见 docs/ROADMAP.md P18.B.0
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_MANAGER_ID=
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=
AD_HEALTH_DIGEST_TO=                   # [可选] 广告健康日报收件人

# ═══════════════════════════════════════════════════════════
# 6. 发布 / 内容协作 / 站点
# ═══════════════════════════════════════════════════════════
PUBLER_API_KEY=                        # [可选] 多平台排期发布
PUBLER_WORKSPACE_ID=
CMS_TOKEN_ENCRYPTION_KEY=              # [可选] 客户 WordPress/CMS token 加密
CLOUDFLARE_MGMT_TOKEN=                 # [可选] 客户站点 DNS / Pages 管理
GITHUB_TOKEN=                          # [可选] GitHub CMS 执行闭环（P12.H）
GITHUB_WEBHOOK_SECRET=
# Airtable —— 正在退役，代码仅剩 3 处引用
AIRTABLE_API_KEY=
FACTORY_OPS_BASE_ID=
FACTORY_REVIEW_TABLE_ID=
WINNER_INTAKE_TABLE_ID=

# ═══════════════════════════════════════════════════════════
# 7. 计费 / 变现（MTC）
# ═══════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_SCALE=

# ═══════════════════════════════════════════════════════════
# 8. 鉴权 / 安全
# ═══════════════════════════════════════════════════════════
ADMIN_EMAILS=                          # 管理员白名单（逗号分隔）
ADMIN_EMAIL_DOMAIN=                    # 管理员邮箱域白名单
CLIENT_VIEWERS=                        # 客户只读账号白名单
INTERNAL_API_KEY=                      # 内部服务间调用（api/factory/signals）
INTERNAL_WORKER_TOKEN=                 # Voice worker 内部鉴权
FACTORY_WORKER_TOKEN=                  # Factory worker 认领工单鉴权
# ⚠️ 不设时会 fallback 到 CRON_SECRET —— 轮换 CRON_SECRET 会作废全部客户上传链接
UPLOAD_LINK_SECRET=
ADMIN_KEY_KILL_SWITCH=                 # [开关] 设 true 紧急关停全部 admin API key
OPENAI_WEBHOOK_SECRET=                 # OpenAI Realtime webhook 校验

# ═══════════════════════════════════════════════════════════
# 9. 邮件 / 通知
# ═══════════════════════════════════════════════════════════
RESEND_API_KEY=                        # 全部事务邮件
ME_MAIL_FROM=
ME_MAIL_TO=
FACTORY_REVIEWER_EMAILS=               # Factory 审核通知收件人
# 线索外联（P35）
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_EMAIL=
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_FIRST_NAME=
OUTREACH_SENDER_COMPANY=
OUTREACH_WEBSITE=

# ═══════════════════════════════════════════════════════════
# 10. Voice Agent（Phase 36）
# ═══════════════════════════════════════════════════════════
OPENAI_PROJECT_ID=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_KB_MODEL=gpt-4o-mini
OPENAI_DEFAULT_VOICE=
REALTIME_WORKER_URL=                   # 独立 worker 的内部 URL（当前 in-process，未启用）
REALTIME_WORKER_PORT=
VOICE_STORE=supabase
VOICE_TEST_NUMBERS=                    # 测试号码白名单
VOICE_DEFAULT_AGENT_ID=                # DID 丢失时的兜底坐席
OUTBOUND_CALLING_ENABLED=false         # [开关] 🔴 外呼总闸，真呼上线前保持 false
DEFAULT_COUNTRY=NZ
DEFAULT_TIMEZONE=Pacific/Auckland
TELEPHONY_PROVIDER=                    # 电话通道实现选择，src/lib/voice/config.ts
WEBHOOK_REPLAY_WINDOW_SECONDS=         # webhook 重放窗口，providers/{openai,mock}.ts
DEFAULT_HUMAN_TRANSFER_URI=tel:+64000000000   # 转人工兜底号码，voice/tools/impl.ts 读

# ── Twilio / WhatsApp：决定 telephony 与 whatsapp 两个 provider 走真实还是 mock ──
# 🔴 生产环境（isProd 且未开 MOCK_EXTERNAL_SERVICES）缺这些会让 provider 落回 mock，
#    voice/config.ts 会直接抛错拒绝启动。别当成没用的变量删掉。
TWILIO_ACCOUNT_SID=                    # 与 TWILIO_AUTH_TOKEN 成对，缺任一 → telephony 落 mock
TWILIO_AUTH_TOKEN=
WHATSAPP_ACCESS_TOKEN=                 # 与 META_APP_SECRET 成对，缺任一 → whatsapp 落 mock
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=                     # Meta webhook 校验

# ═══════════════════════════════════════════════════════════
# 11. 功能开关 / 灰度
# ═══════════════════════════════════════════════════════════
MOCK_EXTERNAL_SERVICES=                # 测试时 mock 全部外部 API
FACTORY_PUBLISH_LIVE=                  # [开关] 🔴 非 true 时片子只发 DRAFT。见 docs/PITFALLS.md A2
FACTORY_WORKER_CLIENT_IDS=             # Factory worker 处理的客户白名单
PROSPECTING_SWEEP_ENABLED=             # 线索挖掘 cron 总闸
JOB_SIGNAL_INGEST_ENABLED=             # 招聘信号采集开关
JOB_SIGNAL_KEYWORDS=
SOCIAL_COMMENT_AUTOREPLY_KILL=         # 社媒评论自动回复紧急关停
SWEEP_CITIES=                          # 线索扫描城市范围
SWEEP_INDUSTRIES=                      # 线索扫描行业范围

# ═══════════════════════════════════════════════════════════
# 12. 客户专用（按需）
# ═══════════════════════════════════════════════════════════
OZTOP_WP_USERNAME=
OZTOP_WP_APP_PASSWORD=

# ═══════════════════════════════════════════════════════════
# 说明：以下变量只在跑脚本时临时传，不需要写进这里
#   SB_KEY / SB_REF          scripts/factory-worker/ingest-clips.mjs
#   DRY_RUN / WRITE / SINCE  scripts/archive/*.ts
#   CLIENT_ID / PLAN_ID      scripts/archive/regenerate-social-plan-images.ts
#   CITY / INDUSTRY / SUB_INDUSTRY   scripts/archive/p30-s4-serp-probe.ts
#   VISION_BASE_URL          scripts/archive/run-vision-analyzer.mjs
#
# 以下变量曾在此模板中但代码已 0 引用（逐个 grep 过 src/ 与 scripts/，排除 archive），本次清理移除：
#   SEMRUSH_API_KEY（已被 DataForSEO 取代；validation-utils.ts 里只是文档举例，不是读取。
#     注意 SEMRUSH_DB 仍在用，别一起删；render.yaml 里那条待清理，见 docs/STATE.md §9）
#   TWILIO_PHONE_NUMBER · META_CAPI_ACCESS_TOKEN · META_PIXEL_ID
#   FACEBOOK_PAGE_ACCESS_TOKEN · NEXT_PUBLIC_ANALYTICS_ID · ENABLE_REAL_GENERATION
#
# ⚠️ 判「零引用」不能只 grep `process.env.X` —— Voice Agent 用 zod schema 声明变量名、
#    再读 `parsed.X`，那种写法 grep `process.env` 完全看不见。必须 grep 变量名本身。
#    本节曾因此误删 9 个仍在用的 Voice Agent 变量（Codex 审出 5 个，复查又找出 4 个）。
# 需要时再从 git 历史取回。
# ═══════════════════════════════════════════════════════════
