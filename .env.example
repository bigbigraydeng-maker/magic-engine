# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenAI Configuration
OPENAI_API_KEY=sk-...

# Cloudflare AI Gateway
# Required ONLY when the AI Gateway has Authenticated mode ON. All OpenAI + Anthropic
# calls route through gateway.ai.cloudflare.com; authenticated gateways reject requests
# without a cf-aig-authorization header. Generate via CF → AI Gateway → Settings →
# Create authentication token. Leave unset if the gateway is unauthenticated.
CF_AIG_TOKEN=

# Feature Flags
ENABLE_REAL_GENERATION=true

# Cron Job Security
CRON_SECRET=your-secure-cron-secret-here

# Social Media APIs (Optional, for production)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Meta Ads — P12.B.2 MetaAdsAdapter
# Long-lived system user token from Meta Business Manager → System Users.
# Needs ads_read permission on the ad account.
META_SYSTEM_USER_TOKEN=

# TikTok Ads — P18.C TikTok Ads Execution Engine
# Long-term access token from TikTok Marketing API app (Business Center → Apps → API Access).
# TIKTOK_ADS_ADVERTISER_ID is the numeric advertiser account ID.
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=

# Google Ads — P18.B Google Ads Execution Engine
# Developer token: apply at https://developers.google.com/google-ads/api/docs/first-call/dev-token
# OAuth2 credentials: Google Cloud Console → APIs → Credentials → OAuth 2.0 Client IDs
# Refresh token: obtained via OAuth consent flow for the manager/client account
# Manager ID: MCC account ID (no dashes), e.g. "1234567890" — omit if not using MCC
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_MANAGER_ID=

# Analytics & Monitoring (Optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Meta (Facebook) Pixel — for Meta Ads conversion tracking + optimization.
# Get from Business Manager → Events Manager → Magic Engine Pixel → 详细信息.
# Leaving this empty disables the Pixel client-side (renders nothing).
NEXT_PUBLIC_META_PIXEL_ID=

# DataForSEO Configuration
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Auth — Admin Whitelist (P8.3.2)
NEXT_PUBLIC_APP_URL=https://your-render-domain.onrender.com
ADMIN_EMAILS=admin@yourdomain.com
ADMIN_EMAIL_DOMAIN=yourdomain.com

# Internal API auth — server-side only, never expose to browser
# Used for server-to-server fire-and-forget calls (e.g. social-suggestions, advanced-discover)
INTERNAL_API_KEY=<generate-random-secret>

# CMS GitHub Connector — AES-256-GCM token encryption (P_CMS.1)
# CRITICAL: generate ONCE, never change after first CMS connection is saved.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CMS_TOKEN_ENCRYPTION_KEY=<64-char-hex-generate-once-never-change>

# Zhangqian AU/NZ local connectors (P8.12.S1.1 / S1.2)
# ABR ABN Lookup — free GUID from https://abr.business.gov.au/Tools/WebServices
ABR_GUID=
# NZBN API v5 subscription key from https://api.business.govt.nz
NZBN_API_KEY=
# SerpAPI key (Google Business Profile reviews) from https://serpapi.com
SERPAPI_API_KEY=

# Contact form — Resend email API (https://resend.com, free tier 3000/month)
# Sign up → API Keys → Create API Key → paste here
# Without this key the /api/contact endpoint returns 503 (form still visible but won't send)
RESEND_API_KEY=your_resend_api_key_here

# ============================================================================
# Voice Agent (AI phone sales/support) — docs/voice-agent/
# ============================================================================
# Leave keys blank to run the mock closed loop. Each provider switches to real
# independently when its keys are present (config resolves per-provider mock/real).
MOCK_EXTERNAL_SERVICES=true

# OpenAI Realtime SIP
OPENAI_PROJECT_ID=proj_xxx
OPENAI_WEBHOOK_SECRET=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_KB_MODEL=gpt-4o-mini
OPENAI_DEFAULT_VOICE=

# Telephony (SIP provider — points origination at OpenAI SIP; see SIP_SETUP.md)
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DEFAULT_HUMAN_TRANSFER_URI=tel:+64000000000

# Meta WhatsApp (P1 only)
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Realtime worker + webhook security
REALTIME_WORKER_URL=http://localhost:4100
REALTIME_WORKER_PORT=4100
INTERNAL_WORKER_TOKEN=
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# Outbound safety (hard-off by default; sandbox test numbers only)
OUTBOUND_CALLING_ENABLED=false
VOICE_TEST_NUMBERS=

# Locale + store selection
DEFAULT_TIMEZONE=Pacific/Auckland
DEFAULT_COUNTRY=NZ
VOICE_STORE=auto
